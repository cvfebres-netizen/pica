# Copiar para .env e preencher. NUNCA publicar este ficheiro.
# Clinica
NOME_CLINICA=Cvfebres Centro Veterinário de Febres
TELEFONE_CLINICA=+351 932 290 927
MORADA_CLINICA=Rua ..., Febres
HORARIO_CLINICA=Seg-Sex 10:00-13:00 e 14:30-19:00; Sab por escala
# Conta Google da clinica (login OAuth + dono do Calendar)
GOOGLE_ACCOUNT=cvfebres@gmail.com
# Link público de agendamento Google (o agente envia-o ao cliente)
LINK_AGENDAMENTO=https://calendar.app.google/6ZPswU6ftN2VKuUC9
# Número do gestor = WhatsApp que aprova (responde OK ou NÃO).
# Pode ser o MESMO da clínica (932290927) — nesse modo não há número separado:
# qualquer OK/NÃO quando existe um pedido pendente é aceite como aprovação,
# e o robô não envia aviso para si mesmo.
NUMERO_GESTOR=351932290927
# Google Calendar (preenchido pelo npm run ligar-google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback
GOOGLE_CALENDAR_ID=primary
# Múltiplos calendários por serviço (opcional — se não preenchido usa GOOGLE_CALENDAR_ID)
# GOOGLE_CAL_CONSULTA=primary
# GOOGLE_CAL_VACINA=primary
# GOOGLE_CAL_BANHO=primary
# GOOGLE_CAL_TOSQUIA=primary
# GOOGLE_CAL_ANALISES=primary
# Fuso
FUSO=Europe/Lisbon
# Painel web do gestor
PORT=3000
